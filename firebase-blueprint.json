{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Barbershop appointment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "barberId": { "type": "string" },
        "serviceIds": { "type": "array" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "totalDuration": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "barberId", "date", "startTime", "status"]
    },
    "Barber": {
      "title": "Barber",
      "description": "Barber staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string" },
        "rating": { "type": "number" },
        "experienceYears": { "type": "number" },
        "active": { "type": "boolean" },
        "pin": { "type": "string" }
      },
      "required": ["id", "name", "title"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "visitCount": { "type": "number" },
        "totalSpent": { "type": "number" }
      },
      "required": ["id", "name", "phone"]
    },
    "Service": {
      "title": "Service",
      "description": "Service item offered by the barbershop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "durationMinutes", "price"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Salon settings",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "managerPin": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/tarik_dilek_appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Appointments collection"
    },
    "/tarik_dilek_barbers/{barberId}": {
      "schema": { "$ref": "#/entities/Barber" },
      "description": "Barbers collection"
    },
    "/tarik_dilek_customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers collection"
    },
    "/tarik_dilek_services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Services collection"
    },
    "/tarik_dilek_settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Salon settings document"
    }
  }
}
